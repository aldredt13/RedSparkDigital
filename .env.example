# Copy to .env for local development, and set the same names in
# Vercel → Settings → Environment Variables (Production + Preview).
# Names must start with VITE_ — Vite only passes those to the website.

# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_…) or legacy "anon" key — never the secret/service_role key
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: search engine ownership verification (meta tag method).
# Google Search Console → Add property → URL prefix → HTML tag → copy only the content="…" value.
# VITE_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML Meta Tag → copy the content value.
# VITE_BING_SITE_VERIFICATION=

# Optional: public site address for canonical/OG links and the sitemap.
# Defaults to Vercel's production domain.
# VITE_SITE_URL=https://red-spark-digital.vercel.app
